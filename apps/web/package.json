{
  "name": "@jk/web",
  "version": "0.1.0",
  "private": true,
  "description": "JK Platform web console (Volume V). React SPA consuming @jk/contracts-rest: tenant-scoped session, governed-AI review, and animal traceability exports.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/contracts-rest": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
