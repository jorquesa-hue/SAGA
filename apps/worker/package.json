{
  "name": "@jk/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SAGA worker: transactional outbox relay with pluggable publishers (NATS JetStream / in-memory) and idempotent projection consumers. \u00a731.1-\u00a731.2, \u00a777.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "dotenv": "^17.4.2",
    "nats": "^2.28.2",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.2",
    "tsx": "^4.23.13",
    "vitest": "^3.2.6"
  }
}
