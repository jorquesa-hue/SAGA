{
  "name": "@jk/api",
  "version": "0.1.0",
  "private": true,
  "description": "SAGA application API: Fastify modular HTTP layer over the bounded-context application services. REST commands, health probes, OIDC skeleton, RFC 9457 Problem Details. \u00a730, \u00a745-\u00a747.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/under-pressure": "^9.0.3",
    "@jk/analytics-intelligence": "workspace:*",
    "@jk/animal-registry": "workspace:*",
    "@jk/assets-maintenance": "workspace:*",
    "@jk/automation-integration": "workspace:*",
    "@jk/database": "workspace:*",
    "@jk/finance-commerce": "workspace:*",
    "@jk/land-grazing": "workspace:*",
    "@jk/nutrition-inventory": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "@jk/health-laboratory": "workspace:*",
    "@jk/herd-operations": "workspace:*",
    "@jk/identity-tenancy": "workspace:*",
    "@jk/observability": "workspace:*",
    "@jk/reporting": "workspace:*",
    "@jk/reproduction-genetics": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "jose": "^5.9.2",
    "pg": "^8.23.0",
    "zod": "^3.23.8",
    "@jk/data-import": "workspace:*",
    "@fastify/cors": "^10.0.2"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
