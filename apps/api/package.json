{
  "name": "@jk/api",
  "version": "0.1.0",
  "private": true,
  "description": "JK Platform application API: NestJS modular monolith on the Fastify adapter. REST commands, health endpoints, Problem Details, OIDC skeleton. §30, §45-§47.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "@jk/identity-tenancy": "workspace:*",
    "@jk/observability": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-fastify": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jose": "^5.10.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.7.14",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.9"
  }
}
