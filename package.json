{
  "name": "jk-platform",
  "private": true,
  "version": "0.1.0",
  "description": "SAGA \u2014 enterprise farm operating system for livestock enterprises. Implements JK-PLT-EES-001.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "typecheck": "pnpm -r --workspace-concurrency=4 run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,mts,mjs,json,yaml,yml,md}\"",
    "format": "prettier --write \"**/*.{ts,mts,mjs,json,yaml,yml,md}\"",
    "test:unit": "pnpm -r --workspace-concurrency=1 run test:unit",
    "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
    "test:tenant-isolation": "pnpm --filter @jk/testkit run test:tenant-isolation",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "architecture:check": "node scripts/validate/architecture-check.mjs",
    "contracts:validate": "node scripts/validate/contracts-validate.mjs",
    "db:migrate": "node scripts/bootstrap/migrate.mjs",
    "db:migrate:test": "node scripts/bootstrap/migrate.mjs --verify",
    "db:seed": "node scripts/bootstrap/generate-demo-seed.mjs && node scripts/bootstrap/seed.mjs",
    "db:seed:generate": "node scripts/bootstrap/generate-demo-seed.mjs",
    "demo:snapshot": "node scripts/demo/generate-demo-snapshot.mjs",
    "demo:static": "node scripts/demo/place-static-demo.mjs",
    "bootstrap": "bash scripts/bootstrap/bootstrap.sh"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "eslint": "^10.8.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.66.0",
    "prettier": "^3.3.3",
    "vitest": "^3.2.6",
    "tsx": "^4.23.11",
    "graphql": "^17.0.2",
    "@apidevtools/swagger-parser": "^12.1.0",
    "yaml": "^2.5.0",
    "pg": "^8.23.0",
    "@types/pg": "^8.21.0",
    "dotenv": "^17.4.2"
  }
}
