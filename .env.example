# JK Platform configuration contract (JK-PLT-EES-001 Appendix G).
# Names and safe local examples only. Production secrets SHALL NOT be
# passed through committed files.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.0.0-local
PUBLIC_WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://jk:jk@localhost:5432/jk_platform
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=jk-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only
OIDC_ISSUER_URL=http://localhost:8080/realms/jk
OIDC_AUDIENCE=jk-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
DEFAULT_LOCALE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
AI_ENABLED=false
AI_PROVIDER=disabled
EDGE_QUEUE_RETENTION_DAYS=7
