{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.saga.example/json-schema/identity.user_invited.v1.payload.schema.json",
  "title": "identity.user_invited.v1 payload",
  "description": "Payload of identity.user_invited.v1 (aggregate: user). Creates a pending tenant membership with a canonical role.",
  "type": "object",
  "required": ["email", "displayName", "role"],
  "additionalProperties": false,
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "role": {
      "$ref": "#/$defs/role"
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "description": "Canonical tenant-membership roles (platform_admin is platform-level, never a membership role).",
      "enum": [
        "tenant_owner",
        "farm_manager",
        "technician",
        "veterinarian",
        "genetics_specialist",
        "finance_user",
        "auditor",
        "integration_service"
      ]
    }
  }
}
