# syntax=docker/dockerfile:1.7
#
# JK Platform — edge gateway image (§34). On-farm device ingestion with a
# durable local buffer; batches observations upstream to the API.
#
# Build from the REPOSITORY ROOT:
#   docker build -f infrastructure/docker/Dockerfile.edge-gateway -t jk-edge-gateway:local .
#
# Stages mirror Dockerfile.api; only the filter target and port differ. The
# durable buffer (EDGE_DATA_FILE) must live on a mounted volume so it survives
# container restarts.

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN corepack enable
WORKDIR /workspace

FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm fetch
COPY package.json turbo.json tsconfig.base.json eslint.config.mjs ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/edge-gateway/package.json apps/edge-gateway/package.json
COPY packages ./packages
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --offline

FROM dependencies AS build
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --offline
RUN pnpm --filter @jk/edge-gateway... run build
RUN pnpm --filter @jk/edge-gateway deploy --prod /out

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production \
    PORT=4200 \
    EDGE_DATA_FILE=/data/edge-outbox.json
RUN useradd --system --uid 10001 --user-group --create-home jk
WORKDIR /app
COPY --from=build --chown=10001:10001 /out ./
# Durable buffer directory (mount a volume here in production).
RUN mkdir -p /data && chown 10001:10001 /data
VOLUME ["/data"]
USER 10001
EXPOSE 4200
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT ?? 4200) + '/health/live').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]
CMD ["node", "dist/main.js"]
