{
  "name": "@jk/nutrition-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Nutrition and Inventory bounded context: item master, batches with expiration, immutable stock ledger with calculated balances and consumption linkage. JK-INV-001..005, §15.1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.11.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
