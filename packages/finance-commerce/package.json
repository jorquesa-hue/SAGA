{
  "name": "@jk/finance-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Finance and Commerce bounded context: operational subledger (expenses/revenue) with allocation, sales, cost/margin per dimension, and budgets. JK-FIN-001..007, JK-DOM-008, §15.2.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
