{
  "name": "@jk/testkit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test harness: disposable PostgreSQL databases, fixture builders, and the cross-tenant isolation attack suite (§67, §81.10, §83).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/tenant-isolation/**' --passWithNoTests",
    "test:integration": "vitest run tests/harness.integration.test.ts --passWithNoTests",
    "test:tenant-isolation": "vitest run tests/tenant-isolation"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "@jk/identity-tenancy": "workspace:*",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
