{
  "name": "@jk/analytics-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Analytics and Intelligence bounded context: due tasks, alert generation with dedupe/lifecycle, and monitoring reports (monthly nucleus, beef lot performance). JK-HLT-002, JK-REP-004, §26, §42, §59.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
