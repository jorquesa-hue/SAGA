{
  "name": "@jk/assets-maintenance",
  "version": "0.1.0",
  "private": true,
  "description": "Assets and Maintenance bounded context: asset register, maintenance/calibration schedules, work orders, device calibration status. JK-AST-001..005, §15.3, §25.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
