    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
