{
  "name": "@jk/brand",
  "version": "0.1.0",
  "private": true,
  "description": "SAGA brand tokens (docs/brand/README.md). TypeScript is the source; tokens.css is generated from it so the web console and the field app cannot disagree about the identity.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tokens": "node scripts/emit-tokens-css.mjs",
    "tokens:check": "node scripts/emit-tokens-css.mjs --check",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
