{
  "name": "@jk/land-grazing",
  "version": "0.1.0",
  "private": true,
  "description": "Land and Grazing bounded context: pasture assessments and grazing metrics (stocking rate, grazing days, kg/ha). JK-PAS-001..004, §14, §20.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
