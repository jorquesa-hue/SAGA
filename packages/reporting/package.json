{
  "name": "@jk/reporting",
  "version": "0.1.0",
  "private": true,
  "description": "Reporting bounded context: a catalogue of parameterised, tenant-scoped operational reports over authoritative records, with an append-only run ledger (immutable snapshots) and CSV delivery. §26 mandatory reports, §47 tenant-scoped reads, §59 dashboards.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.21.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
