{
  "name": "@jk/data-import",
  "version": "0.1.0",
  "private": true,
  "description": "Staged import workflow (§27): upload → parse → map → validate → preview → execute → reconcile → archive. Preserves raw evidence; delegates domain writes to the owning module via an injected executor so module boundaries hold.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.20.3",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
