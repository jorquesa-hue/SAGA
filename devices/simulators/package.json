{
  "name": "@jk/device-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Scale + RFID device simulator: generates a synthetic herd and deterministic weight-observation batches, with configurable flaky delivery, for handling-session and store-and-forward/replay testing. §33, §56, ADR-006, Phase 1 exit.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "devDependencies": {
    "@jk/database": "workspace:*",
    "@jk/domain-kernel": "workspace:*",
    "@jk/herd-operations": "workspace:*",
    "@jk/identity-tenancy": "workspace:*",
    "@jk/testkit": "workspace:*",
    "@types/pg": "^8.11.0",
    "pg": "^8.12.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
