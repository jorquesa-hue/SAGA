# Superuser connection used to reset the schema and apply migrations
# (scripts/db-reset.mjs). Matches infrastructure/docker-compose.yml.
ADMIN_DATABASE_URL=postgres://erp:erp@localhost:5433/erp_escolar_br

# Non-superuser connection the tenant-isolation test suite authenticates
# with — this role is subject to RLS, unlike the superuser above. Created
# by tests/support/local-auth-shim.sql.
APP_DATABASE_URL=postgres://app_test_user:local_test_only_password@localhost:5433/erp_escolar_br
